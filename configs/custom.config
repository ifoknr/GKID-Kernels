# ==============================================================================
# Galaxy Tab S10 Ultra (Dimensity 9300) - GKI 6.1 custom configs
#
# Applied by configs/gki_defconfig.sh on 6.1 builds only.
#
# KMI rule: only ADD built-in features here. Never disable options that vendor
# modules (MediaTek / Samsung) depend on - e.g. CONFIG_FTRACE, CONFIG_DEBUG_FS,
# CONFIG_SLUB_DEBUG - and never change CONFIG_HZ (GKI 6.1 = 250). Doing so breaks
# the KMI and vendor modules fail to load (bootloop / missing hardware).
#
# zRAM options are intentionally not here: on Android 14 zram.ko/zsmalloc.ko are
# loaded from system_dlkm, so options set in this Image have no effect on them.
# ==============================================================================

# ==============================================================================
# 1. CPU frequency governors
# ==============================================================================
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y

# ==============================================================================
# 2. Storage (I/O schedulers + F2FS)
# ==============================================================================
CONFIG_MQ_IOSCHED_DEADLINE=y

# F2FS
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_COMPRESSION=y

# ==============================================================================
# 3. Compression / memory
# ==============================================================================
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# ==============================================================================
# 4. Low-Latency Networking (BBR + FQ-CoDel + IPSet)
# ==============================================================================
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y

# Queueing Disciplines (FQ-CoDel to reduce bufferbloat)
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y

# IP Set Support
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=65534
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_IPMAC=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_SET=y

# IPv6 NAT
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_TARGET_HL=y
